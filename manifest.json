{
  "manifest_version": 3,
  "name": "IdeaVault",
  "version": "0.1.0",
  "description": "Save selected text as notes in your browser's side panel. Notes stay on your device.",
  "minimum_chrome_version": "116",
  "permissions": ["sidePanel", "contextMenus", "storage"],
  "host_permissions": ["https://api.lemonsqueezy.com/*"],
  "background": { "service_worker": "background.js" },
  "side_panel": { "default_path": "panel.html" },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Open IdeaVault",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
